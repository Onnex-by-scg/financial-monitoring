    {
      "name": "00 Connection test",
      "item": [
        {
          "name": "Subsidiary list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "User-Agent-x",
                "value": "SuiteScript-Call"
              }
            ],
            "url": {
              "raw": "https://{{account_host}}.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script={{script_id}}&deploy={{deploy_id}}&service_type=subsidiary&query[current_page]=1",
              "protocol": "https",
              "host": [
                "{{account_host}}",
                "restlets",
                "api",
                "netsuite",
                "com"
              ],
              "path": [
                "app",
                "site",
                "hosting",
                "restlet.nl"
              ],
              "query": [
                {
                  "key": "script",
                  "value": "{{script_id}}"
                },
                {
                  "key": "deploy",
                  "value": "{{deploy_id}}"
                },
                {
                  "key": "service_type",
                  "value": "subsidiary"
                },
                {
                  "key": "query[current_page]",
                  "value": "1",
                  "description": "Page number. Up to 1000 records per page; see data.last_page in the response."
                }
              ]
            },
            "description": "Reference list `subsidiary`. Fields: ns_internal_id, name (and full_name / parent for org lists)."
          },
          "response": []
        }
      ],
      "description": "Smallest read-only call. If this passes, the account ID, keys and RESTlet deployment all work."
    },
