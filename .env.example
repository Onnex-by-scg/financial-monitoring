# Optional. Normally you connect PEAK from the dashboard's Settings page, which saves to .peak/settings.json.
# These values are only used until that file exists (e.g. to pre-fill a fresh install). Copy to .env.local.
PEAK_ENV=uat                      # uat | production  (or set PEAK_BASE_URL)
PEAK_CONNECT_ID=
PEAK_CONNECT_KEY=
PEAK_USER_TOKEN=
PEAK_ENTITY_NAME=ThaiSunny        # tab label for this company
# Several companies sharing the developer credentials:
# PEAK_ENTITIES=CompanyA=<userToken>,CompanyB=<userToken>

# Set to 1 to serve made-up sample data (no PEAK calls)
# PEAK_USE_SAMPLE=1
